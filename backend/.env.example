# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Database (PostgreSQL recommended in production)
# Example:
# DATABASE_URL=postgres://postgres:postgres@db:5432/portfolio
DATABASE_URL=

# CORS (set explicitly in production)
# Example:
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
CORS_ALLOWED_ORIGINS=

# Supabase Storage (S3-compatible API)
# Create three public buckets: profile-assets, cv-files, certificates
# Generate S3 access keys from Supabase Dashboard -> Project Settings -> Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=auto
AWS_STORAGE_BUCKET_NAME=profile-assets
SUPABASE_BUCKET_PROFILE=profile-assets
SUPABASE_BUCKET_CV=cv-files
SUPABASE_BUCKET_CERTIFICATES=certificates

# Rate limiting (app-level; prefer reverse proxy/WAF in production)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# JWT cookie behavior (optional)
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_NAME_ACCESS=access_token
JWT_COOKIE_NAME_REFRESH=refresh_token

# JWT lifetimes
JWT_ACCESS_TOKEN_MINUTES=5
JWT_REFRESH_TOKEN_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=false

# Disable public signups unless you intentionally expose them in the frontend.
AUTH_ALLOW_PUBLIC_REGISTRATION=false
