# Normalize line endings
* text=auto

# Force LF for source files
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf
*.sh    text eol=lf

# Binary files
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
